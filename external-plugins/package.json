{
  "name": "@quartz-community/conll",
  "version": "1.0.0",
  "description": "Conll transformer plugin for Quartz",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "dependencies": {
    "@quartz-community/types": "^1.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^24.10.0",
    "preact": "^10.28.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "conll",
    "displayName": "Conll Transformer",
    "description": "Transforms CoNLL-U formatted data into interactive dependency trees",
    "enabled": false,
    "components": {
      "PageEdit": {
        "name": "PageEdit",
        "displayName": "Page Edit",
        "description": "Shows an edit link for the current page",
        "version": "1.0.0"
      },
      "Status": {
        "name": "Status",
        "displayName": "Status",
        "description": "Shows the page status badge from frontmatter",
        "version": "1.0.0"
      },
      "Request": {
        "name": "Request",
        "displayName": "Request",
        "description": "Shows a request link for the current page",
        "version": "1.0.0"
      },
      "SudLogo": {
        "name": "SudLogo",
        "displayName": "SUD Logo",
        "description": "Displays the SUD logo with a link to the documentation",
        "version": "1.0.0"
      }
    },
    "requiredPlugins": [],
    "optionalPlugins": []
  }
}
